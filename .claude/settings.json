{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git submodule status *)",
      "Bash(php -l *)",
      "Bash(source ../.envrc *)",
      "Bash(wp option get *)",
      "Bash(wp option list *)",
      "Bash(wp post list *)",
      "Bash(wp post get *)",
      "Bash(wp post meta get *)",
      "Bash(wp plugin list *)",
      "Bash(wp theme list *)",
      "Bash(wp core version *)",
      "Bash(wp elementor flush-css *)",
      "Bash(export/export-db.sh *)",
      "Bash(./export/export-db.sh *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git checkout *)",
      "Bash(git submodule update *)",
      "Bash(export/import-db.sh *)",
      "Bash(./export/import-db.sh *)",
      "Bash(wp db *)",
      "Bash(wp search-replace *)",
      "Bash(wp option update *)",
      "Bash(wp option delete *)",
      "Bash(wp post delete *)",
      "Bash(wp post update *)",
      "Bash(wp plugin *)",
      "Bash(wp theme *)",
      "Bash(wp core *)",
      "Bash(rm *)"
    ],
    "deny": [
      "Edit(/wp-admin/**)",
      "Edit(/wp-includes/**)",
      "Edit(/wp-config.php)",
      "Edit(/wp-content/uploads/**)",
      "Edit(/wp-content/themes/hello-elementor/**)",
      "Edit(/wp-content/themes/twentytwentyfive/**)",
      "Edit(/wp-content/plugins/elementor/**)",
      "Edit(/wp-content/plugins/elementor-pro/**)",
      "Edit(/wp-content/plugins/elementor-pro-activator/**)",
      "Edit(/wp-content/plugins/advanced-custom-fields-pro/**)",
      "Edit(/wp-content/plugins/acf-extended-pro/**)",
      "Edit(/wp-content/plugins/all-in-one-wp-migration/**)",
      "Edit(/wp-content/plugins/all-in-one-wp-migration-unlimited-extension/**)",
      "Edit(/wp-content/plugins/image-optimization/**)",
      "Edit(/wp-content/plugins/regenerate-thumbnails/**)",
      "Edit(/wp-content/plugins/wordpress-importer/**)",
      "Edit(/wp-content/themes/hello-theme-child/dist/**)",
      "Edit(/wp-content/themes/hello-theme-child/style.css)"
    ]
  }
}
